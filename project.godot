[input_devices]

; PC'de fare tiklamasi dokunus gibi davransin - TouchScreenButton'lar
; gelistirme sirasinda fareyle de basilabilsin diye.
pointing/emulate_touch_from_mouse=true
; Gercek dokunus hayalet fare olayi URETMESIN: cift tetiklenmeyi onler.
; Bunun sonucu olarak Control tabanli Button'lar dokunusa cevap veremez -
; bilincli tercih, butun etkilesimli dugmeler TouchScreenButton.
pointing/emulate_mouse_from_touch=false

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="pushbox"
2d_physics/layer_3="hurtbox"
2d_physics/layer_4="hitbox"

[physics]

common/max_physics_steps_per_frame=4

[rendering]

textures/canvas_textures/default_texture_filter=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
limits/opengl/max_lights_per_object=4
